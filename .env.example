# Offline by default. Export settings explicitly; .env is not loaded automatically.
OPS_MODE=offline
# Optional HTTP explanation backend (project evidence is sent to this provider).
# OPS_MODE=llm
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=replace-locally
# LLM_MODEL=your-model-name
# Optional local explanation backend: pip install -e '.[local]'
# OPS_MODE=local
# OPS_LOCAL_MODEL=/path/to/downloaded/Qwen3-0.6B
# OPS_LOCAL_MAX_TOKENS=600
