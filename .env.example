# 默认离线模式不产生 API 费用。以下变量需 export，程序不会自动读取 .env。
OPS_MODE=offline
OPS_DATA_DIR=data
OPS_STATE_DIR=var
OPS_RETRIEVER=bm25
# 如需查询本地故障实验日志，指向该次实验的logs.csv：
# OPS_LOG_FILE=/absolute/path/to/var/fault_lab/run-id/logs.csv
# 本地生成模型（不需要API Key，需安装 .[local] 并下载权重）：
# OPS_MODE=local
# OPS_LOCAL_MODEL=/absolute/path/to/var/models/Qwen3-0.6B
# OPS_LOCAL_MAX_TOKENS=600
# 真正的模型规划与生成：改为 llm 并填写支持 tools / JSON response_format 的兼容服务。
# OPS_MODE=llm
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=replace-locally
# LLM_MODEL=your-model-name
# 可选本地语义检索，需安装 .[semantic] 并自行下载模型；默认不下载。
# OPS_EMBED_MODEL=/absolute/path/to/local/sentence-transformer-model
# OPS_EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
